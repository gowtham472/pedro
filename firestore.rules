rules_version = '2';

// Pedro reads and writes Firestore exclusively through the Next.js backend
// (Route Handlers using firebase-admin, which bypasses these rules entirely).
// Client SDKs are only ever used for Firebase Authentication, never for direct
// Firestore access, so we deny all direct client reads/writes here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
